{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Notifications, window focus, external HTTPS links and writing only user-selected save paths",
  "windows": [
    "main"
  ],
  "permissions": [
    "notification:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}
