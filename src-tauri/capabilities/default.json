{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shared app window with notifications and notification-click focus; no filesystem or shell commands",
  "windows": [
    "main"
  ],
  "permissions": [
    "notification:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize"
  ]
}
